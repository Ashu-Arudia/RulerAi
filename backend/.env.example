# RulerAI Backend Environment Variables Example

# Port (assigned automatically by cloud providers like Render/Railway)
PORT=8000

# Frontend URL for CORS permissions
FRONTEND_URL=https://ruler-ai.vercel.app

# Groq LLM API Key (for real-time transcript cleaning, meeting summaries, AskFred AI chat)
GROQ_API_KEY=your_groq_api_key_here

# Database URL (optional, defaults to SQLite 'sqlite:///./fireflies.db' if omitted)
# DATABASE_URL=postgresql://user:password@hostname:5432/ruler_ai
